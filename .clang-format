BasedOnStyle: LLVM
IndentWidth: 4
UseTab: Never
ColumnLimit: 100
LineEnding: LF
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
SortIncludes: Never
IncludeBlocks: Preserve
AttributeMacros:
  - __code
  - __data
  - __xdata
  - __idata
  - __pdata
